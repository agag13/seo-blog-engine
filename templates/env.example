# ─────────────────────────────────────────────────────────────
# Copy to `.env` in the website's project folder and fill in.
# .env is gitignored. NEVER commit real secrets. Only this file is committed.
# The engine reads these from the environment at runtime.
# ─────────────────────────────────────────────────────────────

# ── MULTI-ACCOUNT PROVIDERS ──────────────────────────────────
# Every research provider holds SEVERAL credentials, not one.
#
# This is not over-engineering. Quota exhaustion on a single key is what took
# the Ahrefs route out of one account entirely: the connected Apify account is
# on the free plan, so it returns HTTP 403 "Monthly usage hard limit exceeded"
# on day one of a new month, and no amount of waiting fixes it. A second key
# would have kept the second difficulty source alive.
#
# Numbering: _1 is tried first, then _2, then _3. Gaps are fine. A provider
# with no keys set is reported as unconfigured, never silently skipped.
# The engine logs WHICH key served each call. See scripts/providers.py.

# ── SerpAPI ──
SERPAPI_KEY_1=""
SERPAPI_KEY_2=""
SERPAPI_KEY_3=""

# ── Apify ──
APIFY_TOKEN_1=""
APIFY_TOKEN_2=""
# Plan of the account behind each token, so a 403 can be read correctly.
# free | starter | scale.  A "free" account's hard limit does NOT reset monthly.
APIFY_PLAN_1="free"
APIFY_PLAN_2=""

# ── DataForSEO ── (login/password pairs, so they are numbered together)
DATAFORSEO_LOGIN_1=""
DATAFORSEO_PASSWORD_1=""
DATAFORSEO_LOGIN_2=""
DATAFORSEO_PASSWORD_2=""

# ── Ahrefs ──
# The MCP connector uses OAuth and cannot be authorised from a non-interactive
# run. Set this only if you hold a direct API v3 token.
AHREFS_API_TOKEN_1=""
AHREFS_API_TOKEN_2=""

# ── Tavily ──
TAVILY_API_KEY_1=""
TAVILY_API_KEY_2=""

# ── Moz, optional second backlink source ──
MOZ_ACCESS_ID_1=""
MOZ_SECRET_KEY_1=""

# ── CMS ───────────────────────────────────────────────────────
# WordPress (Application Password: WP Admin -> Users -> Profile -> Application Passwords)
WP_USER=""
WP_APP_PASSWORD=""

# Strapi (Settings -> API Tokens)
STRAPI_API_TOKEN=""

# Ghost (Admin API key: kid:secret)
GHOST_ADMIN_API_KEY=""

# ── Google ────────────────────────────────────────────────────
# Service-account json PATH only. The file itself is gitignored.
GSC_SERVICE_ACCOUNT_JSON=""

# ── Images ────────────────────────────────────────────────────
CLOUDINARY_URL=""
