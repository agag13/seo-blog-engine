# ─────────────────────────────────────────────────────────────
# Copy to `.env` in the website's project folder and fill in.
# .env is gitignored — NEVER commit real secrets.
# The engine reads these from the environment at runtime.
# ─────────────────────────────────────────────────────────────

# WordPress (Application Password: WP Admin -> Users -> Profile -> Application Passwords)
WP_USER="your-wp-username"
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# Strapi (Settings -> API Tokens -> full-access or custom)
STRAPI_API_TOKEN=""

# Ghost (Admin API key: kid:secret)
GHOST_ADMIN_API_KEY=""

# Google Search Console (service-account json path, for indexing/tracking) — path only, file itself gitignored
GSC_SERVICE_ACCOUNT_JSON=""

# Optional: image / research providers
CLOUDINARY_URL=""
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
